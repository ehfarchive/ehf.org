---
import NewsListing from '../../../components/NewsListing.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { NEWS_LISTING_PATH, NEWS_LISTING_PATHS, NEWS_PAGE_SIZE } from '../../../lib/news';
import { loadNewsArticles } from '../_news';

export function getStaticPaths() {
  return NEWS_LISTING_PATHS.slice(1).map((path) => ({
    params: { page: path.slice('/news-blog/page/'.length) }
  }));
}

const pageNumber = Number(Astro.params.page);
const articles = await loadNewsArticles();
const pageItems = articles.slice((pageNumber - 1) * NEWS_PAGE_SIZE, pageNumber * NEWS_PAGE_SIZE);
if (!Number.isInteger(pageNumber) || pageNumber < 2 || pageItems.length === 0) {
  throw new Error(`News page is not available: ${Astro.params.page}`);
}
---

<SiteLayout title={`News — Page ${pageNumber} — Edmund Hillary Fellowship`}>
  <NewsListing articles={pageItems} newerHref={NEWS_LISTING_PATH} imageLoading="eager" />
</SiteLayout>
