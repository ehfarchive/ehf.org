---
import { getCollection, type CollectionEntry } from 'astro:content';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { assetIdForLocalPath } from '../../data/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import contentManifestInput from '../../../source-evidence/content-manifest.json';
import routeManifestInput from '../../../source-evidence/route-manifest.json';
import type { ContentManifest, LocalContentManifestRecord } from '../../lib/page-data';
import { validateContentManifest } from '../../lib/page-data';
import { loadRouteManifest } from '../../lib/route-manifest';
import { parseStrictUtcIsoDate } from '../../lib/iso-date';

type NewsEntry = CollectionEntry<'news'>;
type NewsArticle = { entry: NewsEntry; path: string; publishedAt: Date };

const routeManifest = loadRouteManifest(routeManifestInput);
const contentManifest = contentManifestInput as ContentManifest;
const contentErrors = validateContentManifest(contentManifest);
if (contentErrors.length > 0) throw new Error(contentErrors.join('; '));

const listingPaths = routeManifest.routes
  .filter((route) => route.kind === 'included' && route.family === 'news-listing' && route.path === '/news-blog')
  .map((route) => route.path);
const articlePaths = routeManifest.routes
  .filter((route) => route.kind === 'included' && route.family === 'news-article')
  .map((route) => route.path);
const contentRecords = contentManifest.content
  .filter((record): record is LocalContentManifestRecord => record.template === 'news-article');

if (listingPaths.length !== 1 || listingPaths[0] !== '/news-blog') throw new Error('News listing is not declared exactly once');
if (articlePaths.length !== 21 || new Set(articlePaths).size !== 21) throw new Error('News manifest must declare exactly 21 unique articles');
if (contentRecords.length !== 21 || new Set(contentRecords.map((record) => record.localInput)).size !== 21) {
  throw new Error('News content manifest must declare exactly 21 unique local inputs');
}
if (routeManifest.routes.some((route) => route.kind === 'included' && /^\/news-blog\/page(?:\/|$)/.test(route.path))) {
  throw new Error('News pagination paths are not permitted');
}

const pathByInput = new Map(contentRecords.map((record) => [record.localInput, record.route] as const));
const pathSet = new Set(articlePaths);
const entries = await getCollection('news');
const articles: NewsArticle[] = entries.map((entry) => {
  const path = pathByInput.get(`src/content/news/${entry.id}.md`);
  const publishedAt = entry.data.publishedAt;
  if (!path || !pathSet.has(path)) throw new Error(`News entry is not declared by the manifests: ${entry.id}`);
  if (typeof publishedAt !== 'string') throw new Error(`News entry ${entry.id}.publishedAt must be a valid ISO calendar date`);
  return { entry, path, publishedAt: parseStrictUtcIsoDate(publishedAt, `News entry ${entry.id}.publishedAt`) };
});

if (articles.length !== 21 || articles.length !== pathSet.size || articles.length !== pathByInput.size
  || new Set(articles.map((article) => article.entry.id)).size !== articles.length
  || new Set(articles.map((article) => article.path)).size !== articles.length) {
  throw new Error('News manifests and typed collection entries do not agree');
}

articles.sort((left, right) => right.publishedAt.getTime() - left.publishedAt.getTime()
  || left.entry.id.localeCompare(right.entry.id));
function formatSourceDate(publishedAt: Date): string {
  return `${publishedAt.getUTCMonth() + 1}/${publishedAt.getUTCDate()}/${String(publishedAt.getUTCFullYear()).slice(-2)}`;
}
---

<SiteLayout title="News — Edmund Hillary Fellowship">
  <section class="news-page site-container" data-news-listing>
    <h1 class="visually-hidden">News</h1>
    <div class="news-grid">
      {articles.map(({ entry, path, publishedAt }) => (
        <article class="news-card" data-news-card data-news-slug={entry.id}>
          {entry.data.heroImage && (
            <a class="news-card__image" href={path} aria-label={entry.data.title}>
              <ResponsiveImage
                assetId={assetIdForLocalPath(entry.data.heroImage)}
                alt={entry.data.heroAlt ?? ''}
                width={685}
                height={480}
                sizes="(max-width: 767px) 100vw, 685px"
              />
            </a>
          )}
          <div class="news-card__content">
            <time datetime={entry.data.publishedAt}>{formatSourceDate(publishedAt)}</time>
            <h2><a href={path}>{entry.data.title}</a></h2>
            <a class="news-card__read-more" href={path}>Read More</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .news-page { padding-top: calc(var(--header-height) + 29px); padding-bottom: 161px; }
  .news-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 30px; row-gap: 50px; }
  .news-card { display: flex; min-width: 0; flex-direction: column; }
  .news-card__image { display: block; overflow: hidden; aspect-ratio: 676 / 452; }
  .news-card__image :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .news-card__content { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding-top: 50px; }
  .news-card time { color: var(--color-ink); font-family: var(--font-body); font-size: 16px; font-weight: var(--weight-body); line-height: 19.2px; }
  .news-card h2 {
    margin: 37px 0 30px;
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: var(--weight-heading);
    line-height: var(--lh-card);
  }
  .news-card h2 a { color: inherit; text-decoration: none; }
  .news-card__read-more {
    padding-top: 37px;
    color: var(--color-brand);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: var(--weight-body);
    line-height: 28.8px;
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .news-page { padding-top: calc(var(--header-height) + 8.2px); padding-bottom: 96px; }
    .news-grid { grid-template-columns: 1fr; row-gap: 30px; }
    .news-card__content { padding-top: 20px; }
    .news-card h2 { margin-top: 7.8px; }
    .news-card__read-more { padding-top: 7.8px; }
  }
</style>
