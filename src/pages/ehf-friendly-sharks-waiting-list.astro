---
import DisplayOnlyForm from '../components/DisplayOnlyForm.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
const fields = [
  { id: 'first-name', label: 'First Name (required)', type: 'text', autocomplete: 'given-name' },
  { id: 'last-name', label: 'Last Name (required)', type: 'text', autocomplete: 'family-name' },
  { id: 'email', label: 'Email (required)', type: 'email', autocomplete: 'false' },
  { id: 'subject', label: 'Subject (required)', type: 'text', autocomplete: 'false' },
  { id: 'message', label: 'Message (required)', type: 'textarea' }
] as const;
---
<SiteLayout title="Add me to the EHF ‘Friendly Sharks’ waiting list" minimalFooter><DisplayOnlyForm heading="Add me to the EHF ‘Friendly Sharks’ waiting list" fields={fields} submitLabel="Submit" layout="left-sharks" intro="Just fill out the below form and you will be notified of the upcoming EHF 'Friendly Sharks' Mentor Hours for Founders sessions." /></SiteLayout>
