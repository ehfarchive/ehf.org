---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SnapshotPage from '../components/SnapshotPage.astro';
import StandardPage from '../components/StandardPage.astro';
import LegalPage from '../components/LegalPage.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import contentManifestInput from '../../source-evidence/content-manifest.json';
import routeManifestInput from '../../source-evidence/route-manifest.json';
import aboutEHF from '../content/pages/institutional/about-ehf.json';
import communityCollective from '../content/pages/institutional/communitycollective.json';
import journey from '../content/pages/institutional/journey.json';
import ourValues from '../content/pages/institutional/our-values.json';
import summerEdition from '../content/pages/institutional/summer-edition-2025.json';
import privacyPolicy from '../content/pages/legal/privacy-policy.json';
import refundPolicy from '../content/pages/legal/refund-policy-terms-and-conditions.json';
import termsOfUse from '../content/pages/legal/terms-of-use.json';
import { assetIdForLocalPath } from '../data/site';
import { loadPageData, loadPageSections, type ContentManifest, type RawPageRecord } from '../lib/page-data';
import { loadRouteManifest, type IncludedRouteRecord } from '../lib/route-manifest';

const currentRouteManifest = loadRouteManifest(routeManifestInput);
const pageInputs: Readonly<Record<string, RawPageRecord>> = {
  'src/content/pages/institutional/about-ehf.json': aboutEHF,
  'src/content/pages/institutional/communitycollective.json': communityCollective,
  'src/content/pages/institutional/journey.json': journey,
  'src/content/pages/institutional/our-values.json': ourValues,
  'src/content/pages/institutional/summer-edition-2025.json': summerEdition,
  'src/content/pages/legal/privacy-policy.json': privacyPolicy,
  'src/content/pages/legal/refund-policy-terms-and-conditions.json': refundPolicy,
  'src/content/pages/legal/terms-of-use.json': termsOfUse
};

/* Only /about-ehf is painted as a full-bleed section on the source; the other
   institutional pages keep the centred page-surface column. */
const immersiveBackgrounds: Readonly<Record<string, { assetId: string; alt: string }>> = {
  '/about-ehf': { assetId: assetIdForLocalPath('/assets/images/content/about-ehf-hero-mountain.png'), alt: '' }
};

export async function getStaticPaths() {
  const snapshotEntries = new Map(
    (await getCollection('snapshots')).map((entry) => [`/${entry.id}`, entry])
  );

  return loadRouteManifest(routeManifestInput).routes
    .filter((record): record is IncludedRouteRecord => record.kind === 'included' && (
      record.family === 'institutional' ||
      record.family === 'legal' ||
      record.family === 'fellows-news-snapshot'
    ))
    .map((record) => {
      if (record.family === 'fellows-news-snapshot') {
        const snapshot = snapshotEntries.get(record.path);
        if (!snapshot) throw new Error(`missing snapshot content for ${record.path}`);
        return { params: { page: record.path.slice(1) }, props: { route: record.path, template: record.family, snapshot } };
      }
      return { params: { page: record.path.slice(1) }, props: { route: record.path, template: record.family } };
    });
}

type PageProps =
  | { route: string; template: 'institutional' | 'legal'; snapshot?: never }
  | { route: string; template: 'fellows-news-snapshot'; snapshot: CollectionEntry<'snapshots'> };

const { route, template, snapshot } = Astro.props as PageProps;
if (template === 'fellows-news-snapshot' && !snapshot) throw new Error(`missing snapshot entry for ${route}`);
const SnapshotContent = snapshot ? (await render(snapshot)).Content : undefined;
const contentRecord = template === 'fellows-news-snapshot'
  ? undefined
  : loadPageData(route, template, contentManifestInput as ContentManifest, currentRouteManifest);
const input = contentRecord ? pageInputs[contentRecord.localInput] : undefined;
if (template !== 'fellows-news-snapshot' && !input) throw new Error(`unapproved page input: ${contentRecord?.localInput}`);
const sections = input ? loadPageSections(input, route) : undefined;
---
{template === 'fellows-news-snapshot'
  ? SnapshotContent && snapshot && (
    <SnapshotPage title={snapshot.data.title} excerpt={snapshot.data.excerpt} publishedAt={snapshot.data.publishedAt}>
      <SnapshotContent />
    </SnapshotPage>
  )
  : input && sections && (
    <SiteLayout title={input.title} description={input.description}>
      {template === 'institutional'
        ? <StandardPage title={input.heading} sections={sections} background={immersiveBackgrounds[route]} />
        : <LegalPage title={input.heading} sections={sections} />}
    </SiteLayout>
  )}
