---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="2022/23 Annual Report — Edmund Hillary Fellowship">
  <section class="annual-report site-container">
    <h1>2022/23 Annual Report - Hillary Institute &amp; Edmund Hillary Fellowship</h1>
    <div class="annual-report__grid">
      <section class="annual-report__group">
        <h2>Annual Report</h2>
        <p>Read the 2022/23 Annual Report for the Hillary Institute &amp; Edmund Hillary Fellowship, including highlights and achievements from Hillary Laureates and EHF Fellows.</p>
        <a class="button annual-report__download" data-pdf-download href="/assets/documents/ehf-hi-annual-report-2023.pdf" target="_blank" rel="noopener noreferrer">Download Annual Report</a>
      </section>
      <section class="annual-report__group">
        <h2>Financial Statements</h2>
        <p>View the accompanying Financial Statements for Edmund Hillary Fellowship Ltd.</p>
        <a class="button annual-report__download" data-pdf-download href="/assets/documents/edmund-hillary-fellowship-limited-2023-financial-statements.pdf" target="_blank" rel="noopener noreferrer">Download here</a>
        <p>View the accompanying Financial Statements for The Hillary Institute of International Leadership and Subsidiary Entities for 2022/23.</p>
        <a class="button annual-report__download" data-pdf-download href="/assets/documents/the-hillary-institute-subsidiary-entities-2023-financial-statements.pdf" target="_blank" rel="noopener noreferrer">Download here</a>
      </section>
    </div>
  </section>
</SiteLayout>
