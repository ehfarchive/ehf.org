---
import { getCollection, render } from 'astro:content';
import { assetIdForLocalPath } from '../../data/site';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('impact');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const entries = await getCollection('impact');
const { entry } = Astro.props;
const { Content } = await render(entry);
const nextEntry = entry.data.nextSlug ? entries.find((candidate) => candidate.id === entry.data.nextSlug) : undefined;
const next = nextEntry ? { href: `/read/${nextEntry.id}`, title: nextEntry.data.title } : undefined;
const publishedAt = entry.data.publishedAt ? new Date(`${entry.data.publishedAt}T00:00:00.000Z`) : undefined;
---
{entry.data.heroImage ? (
  <ArticleLayout
    title={entry.data.title}
    description={entry.data.excerpt}
    publishedAt={publishedAt}
    heroAssetId={assetIdForLocalPath(entry.data.heroImage)}
    heroAlt={entry.data.heroAlt ?? ''}
    next={next}
  >
    <Content />
  </ArticleLayout>
) : (
  <SiteLayout title={`${entry.data.title} — Edmund Hillary Fellowship`} description={entry.data.excerpt}>
    <article class="article-page content-width">
      <header class="article-page__header"><h1>{entry.data.title}</h1></header>
      <div class="article-page__body"><Content /></div>
      {next && <nav class="article-page__next" aria-label="Article navigation"><a href={next.href}>{next.title}</a><span class="article-page__next-chevron" aria-hidden="true"></span></nav>}
    </article>
  </SiteLayout>
)}
