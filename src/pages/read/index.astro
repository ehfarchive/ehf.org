---
import PostCard from '../../components/PostCard.astro';
import { impactArchive } from '../../data/impactArchive';
import SiteLayout from '../../layouts/SiteLayout.astro';
---
<SiteLayout title="Read — Edmund Hillary Fellowship">
  <section class="read-page site-container">
    <h1 class="visually-hidden">Read</h1>
    <div class="read-masonry" data-read-masonry>
      {impactArchive.map((post) => (
        <PostCard
          {...post}
          excerpt=""
          imageAlt={post.title}
        />
      ))}
    </div>
    <a class="read-page__older" href="/read/page/2">Older Posts</a>
  </section>
</SiteLayout>
<script>
  const masonry = document.querySelector<HTMLElement>('[data-read-masonry]');
  const gap = 104;

  const resetCards = (cards: HTMLElement[]) => {
    masonry?.style.removeProperty('height');
    cards.forEach((card) => {
      card.style.removeProperty('position');
      card.style.removeProperty('width');
      card.style.removeProperty('transform');
    });
  };

  const layoutMasonry = () => {
    if (!masonry) return;
    const cards = [...masonry.querySelectorAll<HTMLElement>('[data-read-card]')];
    if (window.innerWidth < 768) {
      resetCards(cards);
      return;
    }

    resetCards(cards);
    const width = (masonry.clientWidth - (51 * 3)) / 4;
    const cardHeights = cards.map((card) => Math.round(card.getBoundingClientRect().height));
    const columnHeights = [0, 0, 0, 0];
    cards.forEach((card, index) => {
      const column = columnHeights.indexOf(Math.min(...columnHeights));
      const top = columnHeights[column];
      card.style.position = 'absolute';
      card.style.width = `${width}px`;
      card.style.transform = `translate(${column * (width + 51)}px, ${top}px)`;
      columnHeights[column] = top + cardHeights[index] + gap;
    });
    masonry.style.height = `${Math.max(...columnHeights) - gap}px`;
  };

  let masonryFrame: number | undefined;
  const scheduleMasonry = () => {
    if (masonryFrame !== undefined) return;
    masonryFrame = requestAnimationFrame(() => {
      masonryFrame = undefined;
      layoutMasonry();
    });
  };

  window.addEventListener('resize', scheduleMasonry);
  window.addEventListener('load', scheduleMasonry);
  document.fonts?.ready.then(scheduleMasonry);
  document.fonts?.addEventListener('loadingdone', scheduleMasonry);
  scheduleMasonry();
</script>
