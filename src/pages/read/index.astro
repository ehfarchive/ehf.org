---
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { paginate } from '../../lib/pagination';
import { assetIdForLocalPath } from '../../data/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { IMPACT_PAGE_SIZE, impactListingPagePaths, loadImpactArticles, sourceCardForImpactPath } from './_impact';

const articles = await loadImpactArticles();
const [firstPage = []] = paginate(articles, IMPACT_PAGE_SIZE);
const declaredPageNumbers = impactListingPagePaths();
const declaredPages = [{ number: 1, href: '/read' }, ...declaredPageNumbers.map((number) => ({ number, href: `/read/page/${number}` }))];
---
<SiteLayout title="Read — Edmund Hillary Fellowship">
  <section class="read-page site-container" data-impact-listing data-impact-page-size={IMPACT_PAGE_SIZE}>
    <h1 class="visually-hidden">Read</h1>
    <div class="read-masonry">
      {firstPage.map(({ entry, path }) => {
        const card = sourceCardForImpactPath(path);
        const localPath = card?.localPath ?? entry.data.heroImage;
        return <PostCard
          title={entry.data.title}
          href={path}
          image={localPath ? {
            assetId: assetIdForLocalPath(localPath),
            alt: card ? '' : entry.data.heroAlt ?? '',
            width: 343,
            height: 343,
            focal: card?.focal,
            landscape: card?.landscape
          } : undefined}
          slug={entry.id}
        />;
      })}
    </div>
    <Pagination currentPage={1} pages={declaredPages} />
  </section>
</SiteLayout>
