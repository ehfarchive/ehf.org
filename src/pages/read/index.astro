---
import PostCard from '../../components/PostCard.astro';
import { impactArchive } from '../../data/impactArchive';
import SiteLayout from '../../layouts/SiteLayout.astro';
---
<SiteLayout title="Read — Edmund Hillary Fellowship">
  <section class="read-page site-container">
    <h1>Read</h1>
    <div class="read-masonry" data-read-masonry>
      {impactArchive.map((post) => (
        <PostCard
          {...post}
          excerpt=""
          imageAlt={post.title}
        />
      ))}
    </div>
    <a class="read-page__older" href="/read/page/2">Older Posts</a>
  </section>
</SiteLayout>
