---
import { render } from 'astro:content';
import { assetIdForLocalPath } from '../../../data/site';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { isDeclaredImpactArticlePath, loadImpactArticles } from '../_impact';

const path = '/read/the-awa/river-story-inspiring-connection-action';
if (!isDeclaredImpactArticlePath(path)) throw new Error(`Impact route is not declared: ${path}`);
const articles = await loadImpactArticles();
const position = articles.findIndex((candidate) => candidate.path === path);
const article = articles[position];
if (!article) throw new Error(`Impact content is not declared: ${path}`);
const nextArticle = articles[position + 1];
const { Content } = await render(article.entry);
const publishedAt = new Date(`${article.entry.data.publishedAt}T00:00:00.000Z`);
const hero = article.entry.data.heroImage ? {
  assetId: assetIdForLocalPath(article.entry.data.heroImage),
  alt: article.entry.data.heroAlt ?? ''
} : undefined;
const next = nextArticle ? { href: nextArticle.path, title: nextArticle.entry.data.title } : undefined;
---
<ArticleLayout
  title={article.entry.data.title}
  description={article.entry.data.excerpt}
  publishedAt={publishedAt}
  hero={hero}
  next={next}
>
  <Content />
</ArticleLayout>
