---
import DisplayOnlyForm from '../components/DisplayOnlyForm.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
const fields = [
  { id: 'first-name', label: 'First Name (required)', type: 'text', autocomplete: 'given-name' },
  { id: 'last-name', label: 'Last Name (required)', type: 'text', autocomplete: 'family-name' },
  { id: 'email', label: 'Email (required)', type: 'email', autocomplete: 'false' },
  { id: 'interest', label: 'What is your interest in EHF and New Zealand? (required)', type: 'textarea' },
  { id: 'referral', label: 'How did you hear about EHF? (required)', type: 'textarea' },
  { id: 'ecosystem', label: "I'm part of the NZ ecosystem and am interested to learn about EHF news and events updates", type: 'checkbox' },
  { id: 'visa', label: "I'm interested in updates on if the Global Impact Visa reopens", type: 'checkbox' }
] as const;
---
<SiteLayout title="I want to receive updates on EHF News and Events"><DisplayOnlyForm heading="I want to receive updates on EHF News and Events" fields={fields} submitLabel="Submit" /></SiteLayout>
