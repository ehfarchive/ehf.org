import { getCollection } from 'astro:content';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { archiveNewsCards, archiveReports, archiveSnapshotCards } from '../data/archive';
import { assetIdForLocalPath, resolveSiteAsset } from '../data/site';
import { loadNewsArticles } from './news-blog/_news';

// Cards the source thumbnailed itself carry a localised Archive thumbnail; the
// rest reuse the listing artwork of the collection entry they link to.
const cardImageByPath = new Map<string, string>();
for (const { entry, path } of await loadNewsArticles()) {
  const image = entry.data.listingImage ?? entry.data.heroImage;
  if (image) cardImageByPath.set(path, image);
}
for (const entry of await getCollection('impact')) {
  if (entry.data.heroImage) cardImageByPath.set(`/read/${entry.id}`, entry.data.heroImage);
}
for (const entry of await getCollection('snapshots')) {
  if (entry.data.heroImage) cardImageByPath.set(`/${entry.id}`, entry.data.heroImage);
}

function cardImage(card: { href: string; thumbnail: string | null }): string {
  if (card.thumbnail) return card.thumbnail;
  const localPath = cardImageByPath.get(card.href);
  if (!localPath) throw new Error(`missing Archive card artwork: ${card.href}`);
  return resolveSiteAsset(assetIdForLocalPath(localPath));
}

const newsCards = archiveNewsCards.map((card) => ({ ...card, image: cardImage(card) }));
const snapshotCards = archiveSnapshotCards.map((card) => ({ ...card, image: cardImage(card) }));
