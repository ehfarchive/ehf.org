const news = await loadNewsArticles();
const organisationByPath = new Map(news.map(({ entry, path, publishedAt }) => [path, {
  title: entry.data.title,
  path,
  publishedAt,
  heroImage: entry.data.heroImage,
  heroAlt: entry.data.heroAlt ?? ''
}]));
const everest = (await getCollection('impact')).find((entry) => entry.id === 'celebrating-achievements-and-values-this-everest-day');
if (!everest?.data.publishedAt) throw new Error('missing Everest Day archive article');
organisationByPath.set('/read/celebrating-achievements-and-values-this-everest-day', {
  title: everest.data.title,
  path: '/read/celebrating-achievements-and-values-this-everest-day',
  publishedAt: parseStrictUtcIsoDate(everest.data.publishedAt, 'Everest Day publishedAt'),
  heroImage: everest.data.heroImage,
  heroAlt: everest.data.heroAlt ?? ''
});
const organisationCards = organisationPaths.map((path) => {
  const card = organisationByPath.get(path);
  if (!card) throw new Error(`missing Archive organisation card: ${path}`);
  return card;
});

const snapshots = await getCollection('snapshots');
const snapshotByPath = new Map(snapshots.map((entry) => [`/${entry.id}`, entry]));
const resolvedSnapshots = snapshotCards.map(([path, label]) => {
  const entry = snapshotByPath.get(path);
  if (path !== '/summer-edition-2025' && !entry) throw new Error(`missing Archive snapshot card: ${path}`);
  return {
    path,
    label,
    heroImage: entry?.data.heroImage ?? null,
    heroAlt: entry?.data.heroAlt ?? '',
    fallbackAssetId: path === '/summer-edition-2025' ? 'asset-images-summer-edition-2025-03' : null
  };
});

