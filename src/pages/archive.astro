  .archive-section--wave { position: relative; }
  .archive-section--wave::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -7px;
    left: 0;
    height: 42px;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1454 42" preserveAspectRatio="none"><path d="M0 21c363.5 -18 363.5 -18 727 0s363.5 18 727 0" fill="none" stroke="%237441d2" stroke-width="15"/></svg>') 0 0 / 100% 42px no-repeat;
