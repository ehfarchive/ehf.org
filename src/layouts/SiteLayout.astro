---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/layout.css';
import '../styles/templates.css';

interface Props {
  title: string;
  description?: string;
  minimalFooter?: boolean;
  /* `/watch` paints the header band white over its hero; every other route
     keeps the transparent header that floats above the page. */
  headerSurface?: 'transparent' | 'opaque';
}

const {
  title,
  description = site.description,
  minimalFooter = false,
  headerSurface = 'transparent'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
  </head>
  <body class:list={['page-shell', { 'page-shell--header-opaque': headerSurface === 'opaque' }]}>
    <a class="skip-link" href="#main-content">Skip to Content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer minimal={minimalFooter} />
  </body>
</html>
