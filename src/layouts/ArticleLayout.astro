---
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { renderArticleBody, type FigureAlignment } from '../lib/article-body';
import SiteLayout from './SiteLayout.astro';
interface HeroImage {
  assetId: string;
  alt: string;
}

interface ArticleLink {
  href: string;
  title: string;
}


interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  hero?: HeroImage;
  previous?: ArticleLink;
  next?: ArticleLink;
  suppressHero?: boolean;
  figureAlignments?: readonly FigureAlignment[];
}

const { title, description, hero, previous, next, suppressHero = false, figureAlignments = [] } = Astro.props;
const articleBody = renderArticleBody(await Astro.slots.render('default'), figureAlignments);
---
<SiteLayout title={`${title} — Edmund Hillary Fellowship`} description={description}>
  <article class="article-page content-width" data-impact-article data-figure-alignments={JSON.stringify(figureAlignments)}>
    <header class="article-page__header">
      <h1>{title}</h1>
      {hero && !suppressHero && (
        <figure class="article-page__hero">
          <ResponsiveImage assetId={hero.assetId} alt={hero.alt} width={940} height={627} sizes="(max-width: 767px) 100vw, 940px" loading="eager" />
        </figure>
      )}
    </header>
    <div class="article-page__body" set:html={articleBody} />
    {(previous || next) && <nav class="article-page__next" aria-label="Article navigation">
      {previous && <a href={previous.href}>{previous.title}</a>}
      {next && <a href={next.href}>{next.title}</a>}
    </nav>}
  </article>
</SiteLayout>
