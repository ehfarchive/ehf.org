---
import { footerNavigation, site } from '../data/site';
import NewsletterForm from './NewsletterForm.astro';
---
<footer class="site-footer" role="contentinfo">
  <div class="site-container site-footer__inner">
    <p>© {site.name} 2016 - 2026</p>
    <nav aria-label="Footer navigation">
      <ul>
        {footerNavigation.map((item) => <li><a href={item.href} target={item.kind === 'external' ? '_blank' : undefined} rel={item.kind === 'external' ? 'noreferrer' : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>
    <NewsletterForm />
  </div>
</footer>
