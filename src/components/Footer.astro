---
import { footerNavigation, site } from '../data/site';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
---
<footer class="site-footer" role="contentinfo">
  <div class="site-container site-footer__inner">
    <p>{minimal ? '(c) Edmund Hillary Fellowship 2016 - 2026' : `© ${site.name} 2016 - 2026`}</p>
    <nav aria-label="Footer navigation">
      <ul>
        {footerNavigation.map((item) => <li>{item.kind === 'text' ? <strong>{item.label}</strong> : <a href={item.href}>{item.label}</a>}</li>)}
      </ul>
    </nav>
    {!minimal && <NewsletterForm />}
  </div>
</footer>
