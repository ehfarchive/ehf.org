---
import type { HomeHeroProps } from '../../data/homepage';
import ResponsiveImage from '../ResponsiveImage.astro';

interface Props {
  hero: HomeHeroProps;
}

const { hero } = Astro.props;
---
<section class="home-hero" data-home-hero data-homepage-section={hero.sectionId}>
  <ResponsiveImage
    class="home-hero__image"
    assetId={hero.image.assetId}
    alt={hero.image.alt}
    width={hero.image.width}
    height={hero.image.height}
    sizes={hero.image.sizes}
    loading={hero.image.loading}
  />
  <div class="site-container home-hero__content">
    <h1>{hero.title}</h1>
    <p class="home-hero__lead">{hero.lead}</p>
    {hero.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <div class="home-hero__stats">
      {hero.stats.map((stat) => <p>{stat}</p>)}
    </div>
    {/*
      Source paints a button after the statistics line. No approved included or
      external destination exists for it in the source evidence, so the call to
      action is omitted rather than invented; hero.callToAction carries the
      source label and the disposition behind that decision.
    */}
  </div>
</section>
