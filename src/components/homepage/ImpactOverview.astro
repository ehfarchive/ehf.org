---
import type { ImpactOverviewProps } from '../../data/homepage';
import ResponsiveImage from '../ResponsiveImage.astro';

interface Props {
  overview: ImpactOverviewProps;
}

const { overview } = Astro.props;
---
<section class="organisation-overview" data-home-band data-homepage-section={overview.sectionId}>
  <ResponsiveImage
    class="organisation-overview__image"
    assetId={overview.image.assetId}
    mobile={overview.image.mobile}
    alt={overview.image.alt}
    width={overview.image.width}
    height={overview.image.height}
    sizes={overview.image.sizes}
    loading={overview.image.loading}
  />
  <div class="site-container organisation-overview__content">
    {overview.items.map((item) => (
      <>
        <h2>{item.title}</h2>
        <p>{item.copy}</p>
      </>
    ))}
  </div>
</section>
