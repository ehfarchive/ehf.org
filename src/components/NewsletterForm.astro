---
import { site } from '../data/site';
---
<form class="newsletter-form" data-newsletter-form data-mode={site.newsletter.mode}>
  <label for="newsletter-email">Email address</label>
  <div class="newsletter-form__controls">
    <input id="newsletter-email" name="email" type="email" autocomplete="email" inputmode="email" aria-describedby="newsletter-availability" disabled />
    <button type="submit" disabled>Subscribe</button>
  </div>
  <p id="newsletter-availability" role="status" aria-live="polite">{site.newsletter.message}</p>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form][data-mode="display-only"]').forEach((form) => {
    form.addEventListener('submit', (event) => event.preventDefault());
  });
</script>
