---
import type { PageSection } from '../lib/page-data';

interface Props {
  title: string;
  sections: readonly PageSection[];
}

const { title, sections } = Astro.props;
const external = (href: string) => /^https?:\/\//.test(href);
const displayBody = (body: string) => body
  .replace(/^#{1,6}\s+/, '')
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
  .replaceAll('**', '')
  .replaceAll('*', '');
---
<article class="legal-page" data-page-template="legal">
  <header><h1>{title}</h1></header>
  {sections.map((section) => <section class="legal-page__section">
    {section.heading && section.body !== section.heading && <h2>{section.heading}</h2>}
    {!section.heading || section.body !== section.heading ? <p>{displayBody(section.body)}</p> : null}
    {section.links && <ul class="legal-page__links">
      {section.links.map((link) => <li><a href={link.href} {...(external(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{link.label}</a></li>)}
    </ul>}
  </section>)}
</article>

<style>
  .legal-page { width: min(860px, calc(100% - 2 * var(--gutter))); margin: 0 auto; padding: calc(var(--header-height) + 72px) 0 120px; }
  .legal-page header { margin-bottom: 64px; text-align: center; }
  .legal-page h1 { margin: 0; font-size: var(--text-display); line-height: var(--lh-display); }
  .legal-page h2 { margin: 48px 0 16px; font-size: var(--text-heading); line-height: var(--lh-heading); }
  .legal-page p { margin: 0 0 20px; white-space: pre-line; }
  .legal-page__links { margin: 0 0 24px; padding-left: 20px; }
  .legal-page__links a { color: var(--color-brand); overflow-wrap: anywhere; }
  @media (max-width: 767px) { .legal-page { padding-top: calc(var(--header-height) + 42px); padding-bottom: 72px; } .legal-page header { margin-bottom: 42px; } .legal-page h2 { margin-top: 34px; } }
</style>
