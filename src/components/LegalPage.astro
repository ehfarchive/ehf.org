---
import RichTextBlock from './RichTextBlock.astro';
import { inlineText, parseRichText } from '../lib/rich-text';
import type { PageSection } from '../lib/page-data';

interface Props {
  title: string;
  sections: readonly PageSection[];
}

const { title, sections } = Astro.props;
const external = (href: string) => /^https?:\/\//.test(href);
const parsedSections = sections.map((section) => ({ ...section, block: parseRichText(section.body) }));
const inlineHrefs = new Set(sections.flatMap((section) => [...section.body.matchAll(/\[[^\]]+\]\(([^)]*)\)/g)].map((match) => match[1])));
const firstBlock = parsedSections[0]?.block;
const hasContentTitle = firstBlock?.kind === 'heading' && firstBlock.level <= 3;
const visibleTitle = hasContentTitle ? inlineText(firstBlock.children) : title;
const visibleSections = parsedSections.filter((_, index) => index !== 0 || !hasContentTitle);
---
<article class="legal-page" data-page-template="legal">
  <header><h1>{visibleTitle}</h1></header>
  {visibleSections.map((section) => <section class="legal-page__section">
    <RichTextBlock block={section.block} />
    {section.links && <ul class="legal-page__links">
      {section.links.filter((link) => !inlineHrefs.has(link.href)).map((link) => <li><a href={link.href} {...(external(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{link.label}</a></li>)}
    </ul>}
  </section>)}
</article>

<style>
  .legal-page { width: min(1037px, calc(100% - 2 * var(--gutter))); margin: 0 auto; padding: calc(var(--header-height) + 59px) 0 120px; }
  .legal-page header { margin-bottom: 32px; }
  .legal-page h1 { margin: 0; font-size: var(--text-lead); line-height: var(--lh-lead); }
  .legal-page :global(h2) { margin: 0 0 16px; font-size: 16px; font-weight: 700; line-height: 28.8px; }
  .legal-page :global(p) { margin: 0 0 16px; font-size: 16px; line-height: 28.8px; white-space: pre-line; }
  .legal-page :global(.rich-text-list) { margin: 0 0 16px; padding-left: 20px; font-size: 16px; line-height: 28.8px; }
  .legal-page :global(a) { color: var(--color-brand); overflow-wrap: anywhere; }
  @media (max-width: 767px) { .legal-page { padding-top: calc(var(--header-height) + 72.2px); padding-bottom: 72px; } }
</style>
