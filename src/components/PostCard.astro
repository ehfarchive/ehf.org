---
import ResponsiveImage from './ResponsiveImage.astro';

interface CardImage {
  assetId: string;
  alt: string;
  width: number;
  height: number;
  focal?: string;
  landscape?: boolean;
}

interface Props {
  title: string;
  href: string;
  image?: CardImage;
  slug: string;
}

const { title, href, image, slug } = Astro.props;
---
<article class={`post-card${image?.landscape ? ' post-card--landscape' : ''}`} data-read-card data-impact-slug={slug}>
  {image && (
    <a class="post-card__image" href={href} aria-label={title} style={image.focal ? `--post-card-focal: ${image.focal}` : undefined}>
      <ResponsiveImage assetId={image.assetId} alt={image.alt} width={image.width} height={image.height} sizes="(max-width: 767px) 100vw, 25vw" />
    </a>
  )}
  <h2><a href={href}>{title}</a></h2>
</article>
