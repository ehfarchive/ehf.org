---
import ResponsiveImage from './ResponsiveImage.astro';
import RichTextBlock from './RichTextBlock.astro';
import { inlineText, parseRichText } from '../lib/rich-text';
import type { PageSection } from '../lib/page-data';

interface BackgroundImage {
  assetId: string;
  alt: string;
}

interface Props {
  title: string;
  sections: readonly PageSection[];
  background?: BackgroundImage;
}

const { title, sections, background } = Astro.props;
const external = (href: string) => /^https?:\/\//.test(href);
const supplementalSummerImages: Readonly<Record<string, readonly string[]>> = {
  'asset-images-summer-edition-2025-06': ['asset-images-summer-edition-2025-07'],
  'asset-images-summer-edition-2025-10': ['asset-images-summer-edition-2025-11', 'asset-images-summer-edition-2025-12'],
  'asset-images-summer-edition-2025-13': ['asset-images-summer-edition-2025-14']
};
const parsedSections = sections.map((section) => ({ ...section, block: parseRichText(section.body) }));
const inlineHrefs = new Set(sections.flatMap((section) => [...section.body.matchAll(/\[[^\]]+\]\(([^)]*)\)/g)].map((match) => match[1])));

const firstBlock = parsedSections[0]?.block;
const hasContentTitle = firstBlock?.kind === 'heading' && firstBlock.level <= 3;
const visibleTitle = hasContentTitle ? inlineText(firstBlock.children) : title;
const visibleSections = parsedSections.filter((_, index) => index !== 0 || (!hasContentTitle && sections[0].body !== title));
---
<article class:list={['standard-page', { 'standard-page--immersive': background }]} data-page-template="institutional">
  {background && <ResponsiveImage class="standard-page__backdrop" assetId={background.assetId} alt={background.alt} width={1440} height={650} sizes="100vw" loading="eager" />}
  <header><h1>{visibleTitle}</h1></header>
  {visibleSections.map((section) => {
    const imageLink = section.links?.find((link) => link.href === 'https://www.nztcc.org/commitee/');
    const textLinks = section.links?.filter((link) => link !== imageLink && !inlineHrefs.has(link.href)) ?? [];
    if (imageLink && imageLink.label !== 'Te Ara Rangatira') throw new Error('unexpected Summer image-link label');
    const imageAssetIds = section.imageAssetId
      ? [section.imageAssetId, ...(supplementalSummerImages[section.imageAssetId] ?? [])]
      : [];
    return <section class="standard-page__section">
      <RichTextBlock block={section.block} />
      {imageAssetIds.map((assetId, index) => imageLink && index === 0 ? (
        <a href={imageLink.href} target="_blank" rel="noopener noreferrer" aria-label="Te Ara Rangatira">
          <ResponsiveImage assetId={assetId} alt={section.imageAlt ?? ''} width={510} height={340} sizes="(max-width: 767px) 100vw, 510px" />
        </a>
      ) : (
        <ResponsiveImage assetId={assetId} alt={section.imageAlt ?? ''} width={510} height={340} sizes="(max-width: 767px) 100vw, 510px" />
      ))}
      {textLinks.length > 0 && <ul class="standard-page__links">
        {textLinks.map((link) => <li><a href={link.href} {...(external(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{link.label}</a></li>)}
      </ul>}
    </section>;
  })}
</article>

<style>
  .standard-page { width: min(1010px, calc(100% - 2 * var(--gutter))); margin: 0 auto; padding: calc(var(--header-height) + 72px) 0 120px; }
  .standard-page header { margin-bottom: 72px; text-align: center; }
  .standard-page h1 { margin: 0; font-size: var(--text-display); line-height: var(--lh-display); }
  .standard-page h2 { margin: 56px 0 18px; font-size: var(--text-heading); line-height: var(--lh-heading); }
  .standard-page p { margin: 0 0 24px; white-space: pre-line; }
  .standard-page :global(.rich-text-list) { margin: 0 0 24px; padding-left: 20px; }
  .standard-page :global(a) { color: var(--color-brand); overflow-wrap: anywhere; }
  .standard-page img { display: block; width: min(100%, 510px); height: auto; margin: 28px 0; }
  .standard-page__links { margin: 0 0 28px; padding-left: 20px; }
  @media (max-width: 767px) { .standard-page { padding-top: calc(var(--header-height) + 42px); padding-bottom: 72px; } .standard-page header { margin-bottom: 42px; } .standard-page h2 { margin-top: 38px; } }

  /* Source paints /about-ehf as one full-bleed section: a single localised
     artwork covers the page behind white copy that starts at the gutter rather
     than in the centred 1010px column the other institutional pages use. */
  .standard-page--immersive {
    position: relative;
    isolation: isolate;
    width: 100%;
    margin: 0;
    padding: calc(var(--header-height) + 95.04px) var(--gutter) 95.04px;
    color: var(--color-surface);
  }
  /* The artwork spans the section from row 0 so its cover crop resolves against
     the same box the source uses, then the header band is clipped back off it —
     the same treatment the homepage hero applies — so the first --header-height
     rows keep reading page-surface white. */
  .standard-page--immersive :global(.standard-page__backdrop) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    object-position: 51.1719% 82.9654%;
    clip-path: inset(var(--header-height) 0 0 0);
  }
  .standard-page--immersive header { margin-bottom: 11px; text-align: left; }
  /* Source sets the page title and every level-1 section heading at the display
     step in a 1034px measure, and the level-4 body copy at the sub step in a
     976px measure. RichTextBlock renders the section blocks, so these reach
     them the same way the list and link rules above do. */
  .standard-page--immersive h1,
  .standard-page--immersive :global(h2[data-level='1']) { max-width: 1034px; font-size: var(--text-display); line-height: var(--lh-display); }
  .standard-page--immersive :global(h2[data-level='1']) { margin: 51.7px 0 11px; }
  .standard-page--immersive :global(h2:not([data-level='1'])) {
    max-width: 976px;
    margin: 0;
    font-size: var(--text-sub);
    line-height: var(--lh-sub);
  }
  @media (max-width: 767px) {
    .standard-page--immersive { padding: calc(var(--header-height) + 55.7px) var(--gutter) 55.7px; }
    .standard-page--immersive h1,
    .standard-page--immersive :global(h2) { max-width: none; }
    .standard-page--immersive :global(h2[data-level='1']) { margin-top: 20.7px; }
  }
</style>
