---
/* The source hands every Events Archive recording to a player it embeds from
   embedly. The archive keeps the same 16:9 frame, painted from the localised
   https://i.ytimg.com/vi/<id>/maxresdefault.jpg poster, and links playback out
   to YouTube — so the video id is the whole provenance record for both the
   artwork and the destination. The badge follows the /watch detail frame. */
import ResponsiveImage from './ResponsiveImage.astro';
import { assetIdForLocalPath } from '../data/site';

interface Props {
  id: string;
  label: string;
  sizes?: string;
}

const { id, label, sizes = '(max-width: 767px) 100vw, 453px' } = Astro.props;
const posterId = id.toLowerCase();
---
<a class="archive-video-link" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener noreferrer">
  <ResponsiveImage
    class="archive-video-link__poster"
    assetId={assetIdForLocalPath(`/assets/images/content/archive-events-video-${posterId}.jpg`)}
    alt=""
    width={1280}
    height={720}
    sizes={sizes}
  />
  <span class="archive-video-link__play" aria-hidden="true">
    <svg viewBox="0 0 68 48" focusable="false"><path class="archive-video-link__play-body" d="M66.5 7.5a8.5 8.5 0 0 0-6-6C55.2 0 34 0 34 0S12.8 0 7.5 1.5a8.5 8.5 0 0 0-6 6A88.6 88.6 0 0 0 0 24a88.6 88.6 0 0 0 1.5 16.5 8.5 8.5 0 0 0 6 6C12.8 48 34 48 34 48s21.2 0 26.5-1.5a8.5 8.5 0 0 0 6-6A88.6 88.6 0 0 0 68 24a88.6 88.6 0 0 0-1.5-16.5Z"/><path class="archive-video-link__play-arrow" d="M27 34 45 24 27 14Z"/></svg>
  </span>
  <span class="visually-hidden">Watch “{label}” on YouTube (opens in a new tab)</span>
</a>

<style>
  /* The YouTube badge red, shared with the /watch playback frame. */
  .archive-video-link { --archive-video-badge: #f00; }
  .archive-video-link {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: rgb(0 0 0 / 0.35);
  }
  .archive-video-link :global(.archive-video-link__poster) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .archive-video-link__play { position: absolute; inset: 0; display: grid; place-items: center; }
  .archive-video-link__play svg {
    width: 68px;
    height: 48px;
    transition: transform var(--motion-fast) var(--motion-ease);
  }
  .archive-video-link__play-body { fill: var(--archive-video-badge); }
  .archive-video-link__play-arrow { fill: var(--color-surface); }
  .archive-video-link:hover .archive-video-link__play svg,
  .archive-video-link:focus-visible .archive-video-link__play svg { transform: scale(1.08); }
  @media (max-width: 767px) {
    .archive-video-link__play svg { width: 51px; height: 36px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .archive-video-link:hover .archive-video-link__play svg,
    .archive-video-link:focus-visible .archive-video-link__play svg { transform: none; }
  }
</style>
