---
import ResponsiveImage from './ResponsiveImage.astro';

type InlineSegment = { text: string; emphasis: 'plain' | 'strong' | 'em' | 'strong-em' };
type ProgrammeText = { kind: 'text'; content: string[] };
type ProgrammeItem = { kind: 'item'; time: string; sections: ProgrammeSection[]; isBreak: boolean };
type ProgrammeTrack = { kind: 'track'; label: string; treatment: 'future' | 'innovation' | 'planetary'; content: string[] };
type ProgrammeSection = ProgrammeText | ProgrammeTrack;
type ProgrammeEntry = ProgrammeItem;

interface Props {
  title: string;
  description: string;
  hero?: { assetId: string; alt: string };
  programmeLines?: readonly string[];
  programmeDays?: readonly string[];
  showProgrammeDays?: boolean;
}

const { title, description, hero, programmeLines, programmeDays = [], showProgrammeDays = false } = Astro.props;
const trackTreatments = {
  'Future Of': 'future',
  'Innovation Economy': 'innovation',
  'Planetary Action': 'planetary'
} as const;
const trackLabels = new Set(Object.keys(trackTreatments));
const breakLabels = new Set([
  'Registration Opens',
  'Morning Break - Say hello to someone new!',
  'Lunch Break - Explore the natural surrounds of Waipuna',
  'Take a moment and make your way to your first breakout session',
  'Afternoon Break - Extend your discussion over a cuppa or enjoy a pause in nature',
  'Summit Day One End',
  'Connection Hour - Day One: Connect and Celebrate',
  'Summit Day One Dinner (Add-On Ticket)'
]);

function parseInline(text: string): InlineSegment[] {
  const segments: InlineSegment[] = [];
  let buffer = '';
  let strong = false;
  let em = false;

  const flush = () => {
    if (!buffer) return;
    segments.push({ text: buffer, emphasis: strong && em ? 'strong-em' : strong ? 'strong' : em ? 'em' : 'plain' });
    buffer = '';
  };

  for (let index = 0; index < text.length;) {
    if (text[index] !== '*') {
      buffer += text[index];
      index += 1;
      continue;
    }
    let end = index;
    while (text[end] === '*') end += 1;
    let count = end - index;
    flush();
    while (count >= 3) {
      if (em) em = false;
      else {
        strong = !strong;
        em = true;
      }
      count -= 3;
    }
    if (count === 2) strong = !strong;
    if (count === 1) em = !em;
    index = end;
  }
  flush();
  return segments;
}

function plainInlineText(text: string) {
  return parseInline(text).map((segment) => segment.text).join('');
}


const programmeDaysEntries: ProgrammeEntry[][] = [[]];
let currentProgrammeItem: ProgrammeItem | undefined;
let currentProgrammeSection: ProgrammeSection | undefined;
let dayIndex = 0;
for (const rawLine of programmeLines ?? []) {
  const line = rawLine.trim();
  if (/^\d{1,2}\.\d{2}(?:am|pm)(?:\s*-\s*\d{1,2}\.\d{2}(?:am|pm))?$/i.test(line)) {
    if (line === '8.00am' && programmeDaysEntries[dayIndex].some((entry) => entry.kind === 'item')) {
      dayIndex += 1;
      programmeDaysEntries.push([]);
    }
    currentProgrammeItem = { kind: 'item', time: line, sections: [], isBreak: false };
    currentProgrammeSection = undefined;
    programmeDaysEntries[dayIndex].push(currentProgrammeItem);
  } else if (line && currentProgrammeItem) {
    const plainLine = plainInlineText(line);
    if (breakLabels.has(plainLine)) currentProgrammeItem.isBreak = true;
    if (trackLabels.has(plainLine)) {
      currentProgrammeSection = { kind: 'track', label: plainLine, treatment: trackTreatments[plainLine as keyof typeof trackTreatments], content: [] };
      currentProgrammeItem.sections.push(currentProgrammeSection);
    } else {
      if (!currentProgrammeSection || currentProgrammeSection.kind !== 'text') {
        currentProgrammeSection = { kind: 'text', content: [] };
        currentProgrammeItem.sections.push(currentProgrammeSection);
      }
      currentProgrammeSection.content.push(line);
    }
  }
}
const days = programmeDaysEntries.filter((entries) => entries.length > 0);
if (showProgrammeDays && (programmeDays.length !== 2 || days.length !== 2)) {
  throw new Error('summit programme requires two labelled source days');
}
---

<section class="event-programme site-container" data-event-programme>
  <header class:list={['event-programme__header', { 'event-programme__header--programme': showProgrammeDays }]}>
    <h1 class="visually-hidden">{title}</h1>
    {showProgrammeDays && (
      <div class="event-programme__tablist" role="tablist" aria-label="Summit programme days">
        {programmeDays.map((day, index) => (
          <button
            class="event-programme__tab"
            type="button"
            role="tab"
            id={`summit-day-${index + 1}-tab`}
            aria-controls={`summit-day-${index + 1}-panel`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-event-day-tab
          >{day}</button>
        ))}
      </div>
    )}
    {!showProgrammeDays && <p class="event-programme__description">{description}</p>}
  </header>
  {hero && (
    <ResponsiveImage
      assetId={hero.assetId}
      alt={hero.alt}
      width={2500}
      height={1405}
      sizes="(max-width: 767px) calc(100vw - 48px), 1208px"
      loading="eager"
      class="event-programme__hero"
    />
  )}
  {days.length > 0 ? days.map((entries, index) => (
    <section
      class="event-programme__schedule"
      id={`summit-day-${index + 1}-panel`}
      role={showProgrammeDays ? 'tabpanel' : undefined}
      aria-labelledby={showProgrammeDays ? `summit-day-${index + 1}-tab` : undefined}
      hidden={showProgrammeDays && index !== 0}
      data-event-schedule
      data-event-day-panel
    >
      {entries.map((entry) => (
        <section class:list={['event-programme__item', { 'event-programme__item--break': entry.isBreak }]} data-event-item>
          <p class="event-programme__time" data-event-time>{entry.time}</p>
          <div class="event-programme__item-content" data-event-content>
            {entry.sections.map((section) => section.kind === 'track' ? (
              <section class="event-programme__track-section">
                <div class:list={['event-programme__track', `event-programme__track--${section.treatment}`]} data-event-track>{section.label}</div>
                <div class="event-programme__track-content">
                  {section.content.map((line) => line.startsWith('- ') ? (
                    <li>{parseInline(line.slice(2)).map((segment) => segment.emphasis === 'strong' ? <strong>{segment.text}</strong> : segment.emphasis === 'em' ? <em>{segment.text}</em> : segment.emphasis === 'strong-em' ? <strong><em>{segment.text}</em></strong> : segment.text)}</li>
                  ) : (
                    <p>{parseInline(line).map((segment) => segment.emphasis === 'strong' ? <strong>{segment.text}</strong> : segment.emphasis === 'em' ? <em>{segment.text}</em> : segment.emphasis === 'strong-em' ? <strong><em>{segment.text}</em></strong> : segment.text)}</p>
                  ))}
                </div>
              </section>
            ) : (
              <div class="event-programme__plain-content">
                {section.content.map((line) => line.startsWith('- ') ? (
                  <li>{parseInline(line.slice(2)).map((segment) => segment.emphasis === 'strong' ? <strong>{segment.text}</strong> : segment.emphasis === 'em' ? <em>{segment.text}</em> : segment.emphasis === 'strong-em' ? <strong><em>{segment.text}</em></strong> : segment.text)}</li>
                ) : (
                  <p>{parseInline(line).map((segment) => segment.emphasis === 'strong' ? <strong>{segment.text}</strong> : segment.emphasis === 'em' ? <em>{segment.text}</em> : segment.emphasis === 'strong-em' ? <strong><em>{segment.text}</em></strong> : segment.text)}</p>
                ))}
              </div>
            ))}
          </div>
        </section>
      ))}
    </section>
  )) : (
    <article class="event-programme__content" data-event-schedule><slot /></article>
  )}
</section>

{showProgrammeDays && (
  <script>
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-event-day-tab]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-event-day-panel]')];
    const selectDay = (selectedIndex: number) => {
      tabs.forEach((tab, index) => {
        const selected = index === selectedIndex;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[index].hidden = !selected;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectDay(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        tabs[nextIndex].focus();
        selectDay(nextIndex);
      });
    });
  </script>
)}

<style>
  .event-programme { padding-top: calc(var(--header-height) + 95px); padding-bottom: 96px; }
  .event-programme__header { margin-bottom: 18px; }
  .event-programme__header--programme { margin-bottom: 20px; }
  .event-programme__tablist { display: flex; align-items: end; gap: 5px; }
  /* Source paints no rule under the tab strip and no bottom border on either
     tab: the 56px box is 1px of top border over a 35.0208px line box with 10px
     of padding above and below. Only the fill and the weight separate the two
     states. */
  .event-programme__tab { position: relative; z-index: 1; border: 1px solid #ccc; border-bottom: 0; border-radius: 5px 5px 0 0; padding: 10px 20px; background: #f0f0f0; color: #000; font: 300 19.456px/35.0208px var(--font-body); text-transform: none; cursor: pointer; }
  .event-programme__tab[aria-selected='true'] { background: var(--color-surface); font-weight: 700; }
  .event-programme__description { max-width: 918px; margin: 0; }
  :global(.event-programme__hero) { display: block; width: 100%; height: auto; margin: 0 0 36px; }
  .event-programme__content { border-top: 1px solid #ddd; }
  .event-programme__content :global(p), .event-programme__content :global(li) { font-size: 16px; line-height: 1.8; }
  .event-programme__content :global(p) { margin: 0; padding: 15px 18px; border-bottom: 1px solid #e2e2e2; }
  .event-programme__content :global(h3), .event-programme__content :global(h4) { margin: 30px 0 0; padding: 14px 18px; background: var(--color-brand); color: var(--color-surface); font-size: var(--text-lead); line-height: var(--lh-lead); }
  .event-programme__content :global(ul) { margin: 0; padding: 16px 38px; border-bottom: 1px solid #e2e2e2; }
  .event-programme__content :global(a) { color: var(--color-brand); }
  /* Source runs the schedule 13px wider than the container on each side while
     the tabs stay on the container edge, which puts the time text at 34.8px and
     the entry text between 145.8px and 1405.2px at desktop (29.4px / 140.4px /
     360.6px at mobile). */
  .event-programme__schedule { margin-inline: -13px; border: 1px solid #ccc; }
  /* Source rows take their height from their copy alone: a 21px inset above and
     below (5px of cell padding over a 16px paragraph margin) with 16px between
     stacked paragraphs. A one-line row therefore measures 71.8px on its own, so
     nothing needs a floor height. */
  .event-programme__item { display: grid; grid-template-columns: 111px minmax(0, 1fr); border-bottom: 1px solid #ccc; }
  .event-programme__item--break { background: #eee; }
  .event-programme__time { margin: 0; border-right: 1px solid #ccc; padding: 21px 18px; font: 300 16px/28.8px var(--font-body); }
  /* Source paints the programme rows in pure black, not the site ink. */
  .event-programme__time,
  .event-programme__item-content p,
  .event-programme__item-content li { color: #000; }
  .event-programme__item-content { min-width: 0; }
  .event-programme__plain-content { padding: 21px 18px; }
  .event-programme__item-content p { margin: 0 0 16px; font-size: 16px; line-height: 1.8; }
  .event-programme__item-content p:last-child { margin-bottom: 0; }
  /* Source sets bullets on a 35.0208px line with no space between them and the
     usual 16px between the run and the paragraphs around it. */
  .event-programme__item-content li { margin: 0; font: 16px/35.0208px var(--font-body); }
  .event-programme__item-content li + p { margin-top: 16px; }
  .event-programme__item-content strong { font-weight: 700; }
  .event-programme__track-section + .event-programme__track-section { border-top: 1px solid #e2e2e2; }
  .event-programme__track { padding: 26px 18px; color: var(--color-surface); font: 400 16px/1.2 var(--font-body); }
  .event-programme__track--future { background: #92c5e3; }
  .event-programme__track--innovation { background: #806daf; }
  .event-programme__track--planetary { background: #75b2bd; }
  .event-programme__track-content { border-bottom: 1px solid #e2e2e2; padding: 18px; }
  .event-programme__track-content p { margin: 0 0 10px; font-size: 16px; line-height: 1.8; }
  .event-programme__track-content p:last-child { margin-bottom: 0; }
  .event-programme__track-content li { margin: 0 0 8px; font: 16px/1.5 var(--font-body); }

  @media (max-width: 767px) {
    .event-programme { padding-top: calc(var(--header-height) + 55px); padding-bottom: 64px; }
    .event-programme__tablist { gap: 5px; }
    .event-programme__tab { font-size: 18.0256px; line-height: 32.4461px; }
    .event-programme__content :global(p) { padding: 12px 10px; }
    .event-programme__content :global(h3), .event-programme__content :global(h4) { padding: 12px 10px; }
    .event-programme__time { padding: 21px 18px; }
    .event-programme__item-content p { font-size: 16px; line-height: 1.8; }
    .event-programme__item-content li { font-size: 16px; }
    .event-programme__track-content { padding: 15px 18px; }
    .event-programme__track-content p { font-size: 16px; line-height: 1.8; }
    .event-programme__track-content li { font-size: 16px; }
    .event-programme__track { padding: 26px 18px; font-size: 16px; }
  }
</style>
