---
import Pagination from './Pagination.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { assetIdForLocalPath } from '../data/site';
import { NEWS_LISTING_PAGES, NEWS_PAGE_SIZE } from '../lib/news';
import { paginate } from '../lib/pagination';
import { formatNewsDate, type NewsArticle } from '../pages/news-blog/_news';

interface Props {
  articles: readonly NewsArticle[];
}

const { articles } = Astro.props;
const pages = paginate(articles, NEWS_PAGE_SIZE);
if (pages.length !== NEWS_LISTING_PAGES.length) {
  throw new Error(`News listing splits into ${pages.length} pages, source declares ${NEWS_LISTING_PAGES.length}`);
}
---
<section class="news-page site-container" data-news-listing data-news-page-size={NEWS_PAGE_SIZE}>
  <h1 class="visually-hidden">News</h1>
  {pages.map((pageArticles, index) => (
    <div data-news-page={index + 1}>
      <div class="news-grid">
        {pageArticles.map(({ entry, path, publishedAt }) => (
          <article class="news-card" data-news-card data-news-slug={entry.id}>
            {entry.data.listingImage && (
              <a class="news-card__image" href={path} aria-label={entry.data.title} style={entry.data.listingImagePosition ? `--news-listing-object-position: ${entry.data.listingImagePosition}` : undefined}>
                <ResponsiveImage
                  assetId={assetIdForLocalPath(entry.data.listingImage)}
                  alt={entry.data.listingAlt}
                  width={685}
                  height={480}
                  sizes="(max-width: 767px) 100vw, 685px"
                  loading="lazy"
                />
              </a>
            )}
            <div class="news-card__content">
              <time datetime={entry.data.publishedAt}>{formatNewsDate(publishedAt)}</time>
              <h2><a href={path}>{entry.data.title}</a></h2>
              <a class="news-card__read-more" href={path}>Read More</a>
            </div>
          </article>
        ))}
      </div>
      <Pagination listing="news" page={NEWS_LISTING_PAGES[index]} />
    </div>
  ))}
</section>

<script type="application/json" id="news-pagination-cursors" is:inline set:html={JSON.stringify(NEWS_LISTING_PAGES)} />
<script is:inline>
  (function () {
    var cursors = JSON.parse(document.getElementById('news-pagination-cursors').textContent);
    var groups = document.querySelectorAll('[data-news-page]');
    var controls = document.querySelectorAll('[data-query-pagination][data-pagination-listing="news"]');

    function pageForQuery(search) {
      for (var index = 0; index < cursors.length; index += 1) {
        if (cursors[index].older === search) return index + 1;
        if (cursors[index].newer === search) return index - 1;
      }
      return 0;
    }

    function render(moveFocus) {
      var page = pageForQuery(window.location.search);
      for (var group = 0; group < groups.length; group += 1) {
        groups[group].hidden = Number(groups[group].getAttribute('data-news-page')) !== page + 1;
      }
      for (var control = 0; control < controls.length; control += 1) {
        controls[control].hidden = Number(controls[control].getAttribute('data-pagination-page')) !== page + 1;
      }
      if (moveFocus) {
        var activeControl = controls[page];
        var activeLink = activeControl && activeControl.querySelector('a');
        if (activeLink) activeLink.focus({ preventScroll: true });
      }
    }
    document.addEventListener('click', function (event) {
      if (!(event.target instanceof Element)) return;
      var target = event.target.closest('[data-query-pagination][data-pagination-listing="news"] a');
      if (!target || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      var href = target.getAttribute('href');
      if (!href || href.charAt(0) !== '?') return;
      event.preventDefault();
      window.history.pushState(null, '', href);
      render(true);
    });
    window.addEventListener('popstate', function () { render(false); });
    render(false);
  })();
</script>

<style>
  .news-page { padding-top: calc(var(--header-height) + 29px); padding-bottom: 161px; }
  .news-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 30px; row-gap: 50px; }
  .news-card { display: flex; min-width: 0; flex-direction: column; }
  .news-card__image { display: block; overflow: hidden; aspect-ratio: 676 / 452; }
  .news-card__image :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--news-listing-object-position, 50% 50%); }
  .news-card__content { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding-top: 50px; }
  .news-card time { color: var(--color-ink); font-family: var(--font-body); font-size: 16px; font-weight: var(--weight-body); line-height: 19.2px; }
  .news-card h2 {
    margin: 37px 0 30px;
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: var(--weight-heading);
    line-height: var(--lh-card);
  }
  .news-card h2 a { color: inherit; text-decoration: none; }
  .news-card__read-more {
    padding-top: 37px;
    color: var(--color-brand);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: var(--weight-body);
    line-height: 28.8px;
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .news-page { padding-top: calc(var(--header-height) + 8.2px); padding-bottom: 96px; }
    .news-grid { grid-template-columns: 1fr; row-gap: 30px; }
    .news-card__content { padding-top: 20px; }
    .news-card h2 { margin-top: 7.8px; }
    .news-card__read-more { padding-top: 7.8px; }
  }
</style>
